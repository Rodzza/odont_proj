# Copie para .env e preencha. Nunca envie o .env para o GitHub.
DATABASE_URL=sqlite:///./odonto.db
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
FRONTEND_URL=http://localhost:5173
AMBIENTE=dev
# IA (Claude): crie a chave em https://console.anthropic.com. Sem ela, as funções de IA ficam desligadas.
ANTHROPIC_API_KEY=
IA_MODELO=claude-sonnet-5-5
IA_MODELO_RAPIDO=claude-haiku-5-5
# Busca entre pacientes: embeddings da Voyage AI (https://dash.voyageai.com). No Postgres, precisa da extensão pgvector (o Supabase já tem).
VOYAGE_API_KEY=
VOYAGE_MODELO=voyage-3.5
